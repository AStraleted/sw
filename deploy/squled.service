# Служба systemd для SQULED Studio
# 1. Поправьте User и пути под свой сервер
# 2. sudo cp deploy/squled.service /etc/systemd/system/
# 3. sudo systemctl enable --now squled
# Логи: journalctl -u squled -f

[Unit]
Description=SQULED Studio
After=network.target

[Service]
Type=simple
User=squled
WorkingDirectory=/opt/squled-studio
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# Ограничения прав: служба пишет только в свою папку data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/squled-studio/data

[Install]
WantedBy=multi-user.target
